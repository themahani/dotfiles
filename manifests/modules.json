{
  "bash": {
    "links": {"~/.bashrc": "bash/.bashrc"},
    "packages": ["bash"], "commands": ["bash"]
  },
  "zsh": {
    "links": {"~/.zshrc": "zsh/.zshrc", "~/.antigen.zsh": "zsh/antigen/antigen.zsh"},
    "packages": ["zsh"], "commands": ["zsh"]
  },
  "git": {
    "links": {"$CONFIG/git": "config/git"},
    "packages": ["git"], "commands": ["git"]
  },
  "neovim": {
    "links": {
      "$CONFIG/nvim": "config/nvim", "$CONFIG/dotfiles/nvim.lua": "config/dotfiles/nvim.lua",
      "$CONFIG/dotfiles/schemas.lua": "config/dotfiles/schemas.lua",
      "$CONFIG/dotfiles/.luarc.json": "config/dotfiles/.luarc.json"
    },
    "packages": ["neovim", "git", "base-devel", "unzip", "curl", "ripgrep", "fd", "tree-sitter-cli", "nodejs", "npm", "python", "python-pip"],
    "commands": ["nvim", "rg", "fd", "cc", "node", "npm", "python3", "tree-sitter"]
  },
  "tmux": {
    "links": {"~/.tmux.conf": "tmux/tmux.conf", "~/.tmux/plugins/tpm": "tmux/plugins/tpm"},
    "packages": ["tmux"], "commands": ["tmux"]
  },
  "kitty": {
    "links": {"$CONFIG/kitty": "config/kitty"},
    "requires": ["fonts"],
    "packages": ["kitty"], "commands": ["kitty"]
  },
  "fonts": {
    "links": {"$CONFIG/fontconfig": "config/fontconfig"},
    "packages": ["ttf-jetbrains-mono-nerd", "ttf-ubuntu-font-family", "ttf-ubuntu-nerd", "ttf-roboto", "ttf-material-symbols-variable", "noto-fonts-emoji"],
    "aur": ["vazirmatn-fonts"]
  },
  "cli-extras": {
    "packages": ["eza", "lazygit", "lazydocker", "fzf", "bat", "zoxide"],
    "commands": ["eza", "lazygit", "lazydocker"]
  },
  "java": {"packages": ["jdk-openjdk"], "commands": ["java"]},
  "latex": {"packages": ["texlive-binextra", "texlive-latexextra", "biber"], "commands": ["latexmk"]},
  "rust": {"packages": ["rust"], "commands": ["cargo"]},
  "hyprland-desktop": {
    "links": {
      "$CONFIG/hypr": "config/hypr", "$CONFIG/quickshell/desktop": "config/quickshell",
      "$CONFIG/rofi": "config/rofi", "$CONFIG/matugen": "config/matugen",
      "$CONFIG/qt6ct/qt6ct.conf": "config/qt6ct/qt6ct.conf",
      "$CONFIG/qt6ct/colors/catppuccin-mocha-blue.conf": "config/qt6ct/colors/catppuccin-mocha-blue.conf",
      "$CONFIG/wlogout": "config/wlogout", "$CONFIG/dotfiles/hypr.lua": "config/dotfiles/hypr.lua",
      "$CONFIG/dotfiles/schemas.lua": "config/dotfiles/schemas.lua",
      "$CONFIG/dotfiles/.luarc.json": "config/dotfiles/.luarc.json"
    },
    "requires": ["kitty", "fonts"],
    "packages": ["hyprland", "hypridle", "hyprlock", "hyprpaper", "hyprlauncher", "hyprpolkitagent", "hyprshot", "hyprshutdown", "quickshell", "matugen", "qt6ct", "qt6-declarative", "qt6-wayland", "qt6-svg", "python", "iproute2", "upower", "power-profiles-daemon", "util-linux", "sound-theme-freedesktop", "rofi", "rofi-calc", "rofi-emoji", "nautilus", "jq", "wl-clipboard", "brightnessctl", "pavucontrol", "playerctl", "libnotify", "network-manager-applet", "networkmanager", "nm-connection-editor", "btop", "bluez", "bluez-utils", "pipewire", "pipewire-pulse", "wireplumber", "xdg-desktop-portal-hyprland", "xdg-desktop-portal-gtk", "xorg-xwayland", "telegram-desktop"],
    "aur": ["wlogout", "blueberry"],
    "commands": ["Hyprland", "hyprctl", "quickshell", "python3", "ip", "brightnessctl", "pw-play", "rfkill", "rofi", "jq", "wlogout", "blueberry", "btop", "nm-connection-editor", "matugen"]
  },
  "music": {
    "links": {"$CONFIG/mpd": "config/mpd", "$CONFIG/rmpc": "config/rmpc"},
    "packages": ["mpd", "rmpc"], "commands": ["mpd", "rmpc"]
  },
  "irssi": {
    "links": {"~/.irssi/tzu.theme": "irssi/tzu.theme"},
    "packages": ["irssi"], "commands": ["irssi"]
  }
}
