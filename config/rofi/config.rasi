/* Standalone rofi config + theme (Catppuccin Mocha).
 * Self-contained: no @import, no external theme files. */

configuration {
    modes: "drun,emoji,calc,combi";
    combi-modes: "drun,emoji";
    show-icons: false;
    drun-match-fields: "name,generic,keywords,comment,categories";
    drun-show-actions: true;
    font: "JetBrains Mono 12";
}

* {
    bg:     #1e1e2e;
    fg:     #cdd6f4;
    lav:    #b4befe;
    mauve:  #cba6f7;
    pink:   #f38ba8;
}

window {
    width: 960px;
    background-color: @bg;
    border: 1px;
    border-color: @lav;
    border-radius: 6px;
    padding: 40px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 32px;
    background-color: transparent;
}

inputbar {
    children: [ icon-search, entry ];
    spacing: 12px;
    background-color: transparent;
}

icon-search {
    expand: false;
    str: "";
    text-color: @pink;
    background-color: transparent;
}

entry {
    text-color: @fg;
    placeholder: "";
    background-color: transparent;
}

listview {
    lines: 8;
    fixed-height: true;
    spacing: 8px;
    scrollbar: false;
    background-color: transparent;
}

/* override rofi's default normal/alternate row colors */
element,
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active,
element normal.urgent,
element alternate.urgent {
    padding: 8px;
    border-radius: 6px;
    background-color: transparent;
    text-color: @fg;
}

element selected.normal,
element selected.active,
element selected.urgent {
    border: 1px;
    border-color: @lav;
    background-color: transparent;
    text-color: @mauve;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
