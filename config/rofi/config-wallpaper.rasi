/* Standalone wallpaper selector: thumbnail grid with the same look as
 * config.rasi. Works as `rofi -theme config-wallpaper.rasi`. */

configuration {
    modi: "dmenu";
    show-icons: true;
    font: "JetBrains Mono 12";
}

/* Colors: the committed Material fallback, overridden by the wallpaper colors
 * matugen generates (config/matugen). A missing import is ignored. */
@import "matugen-fallback.rasi"
@import "~/.local/state/matugen/rofi.rasi"

window {
    width: 75%;
    height: inherit;
    background-color: @bg;
    border: 1px;
    border-color: @accent;
    border-radius: 6px;
    padding: 40px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 32px;
    background-color: transparent;
}

inputbar {
    children: [ icon-search, entry ];
    spacing: 12px;
    background-color: transparent;
}

icon-search {
    expand: false;
    str: "";
    text-color: @icon-fg;
    background-color: transparent;
}

entry {
    expand: true;
    placeholder: " Search / Choose Wallpaper";
    horizontal-align: 0.5;
    text-color: @fg;
    placeholder-color: @selected-fg;
    background-color: transparent;
}

/* thumbnail grid */
listview {
    columns: 6;
    lines: 1;
    flow: horizontal;
    fixed-width: true;
    fixed-height: true;
    cycle: true;
    spacing: 20px;
    padding: 10px;
    scrollbar: false;
    background-color: transparent;
}

/* unselected: transparent 1px border keeps size stable when selection moves */
element,
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active,
element normal.urgent,
element alternate.urgent {
    orientation: vertical;
    padding: 8px;
    margin: 0px;
    spacing: 0px;
    border: 1px;
    border-color: transparent;
    border-radius: 6px;
    background-color: transparent;
    text-color: @fg;
}

/* selected: same 1px accent border + highlight text as the main config */
element selected.normal,
element selected.active,
element selected.urgent {
    orientation: vertical;
    padding: 8px;
    margin: 0px;
    spacing: 0px;
    border: 1px;
    border-color: @accent;
    border-radius: 6px;
    background-color: transparent;
    text-color: @selected-fg;
}

element-icon {
    size: 20%;
    margin: -30px;
    cursor: inherit;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.5;
    padding: 6px;
    margin: 6px;
    background-color: transparent;
    text-color: inherit;
}
