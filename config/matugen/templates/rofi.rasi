/* Generated by matugen from the wallpaper; edit config/matugen/templates/rofi.rasi. */
* {
    bg:          {{colors.surface_container.default.hex}};
    fg:          {{colors.on_surface.default.hex}};
    accent:      {{colors.primary.default.hex}};
    selected-fg: {{colors.primary.default.hex}};
    icon-fg:     {{colors.tertiary.default.hex}};
}
