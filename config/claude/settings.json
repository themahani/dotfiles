{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.dotfiles/config/claude/mods/token-bar",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "model": "opus",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Apply the unslop rules from CLAUDE.md to all prose in your reply (chat text, commit/PR messages, docs, comments).\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/format.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "theme": "dark",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": false,
    "design@synced": false
  },
  "skillOverrides": {
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:learn": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:unslop": "off",
    "anthropic-skills:xlsx": "off",
    "benchmark-checklist": "off",
    "blast-radius": "off",
    "principle-explain-the-number": "off",
    "principle-prove-it-works": "off",
    "principle-subtract-before-you-add": "off"
  },
  "permissions": {
    "defaultMode": "auto"
  }
}
