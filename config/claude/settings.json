{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"Apply the unslop rules from CLAUDE.md to all prose in your reply (chat text, commit/PR messages, docs, comments).\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.dotfiles/config/claude/mods/token-bar"
  },
  "autoUpdatesChannel": "stable",
  "theme": "dark",
  "model": "opus"
}
